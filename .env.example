# Configuração do banco Postgres
POSTGRES_DB=expense-manager
POSTGRES_USER=expense-manager
POSTGRES_PASSWORD=changeme123

# Configuração do backend (.NET)
ASPNETCORE_ENVIRONMENT=Development

# Connection string usada pelo EF Core dentro do container.
# Host "postgres" é o nome do serviço no docker-compose.yml.
# Valores escritos por extenso propositalmente: env_file não expande
# ${VAR} referenciando outra linha do próprio .env.
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=expense-manager;Username=expense-manager;Password=changeme123

# Configuração do frontend (Vite)
# URL que o frontend usa para chamar a API do backend.
VITE_API_URL=http://localhost:8080
